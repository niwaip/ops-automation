{
  "name": "@ops/backend-deterministic-plan",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "description": "Shared deterministic plan contracts and utilities",
  "main": "./index.js",
  "types": "./index.d.ts",
  "exports": {
    ".": {
      "types": "./index.d.ts",
      "default": "./index.js"
    }
  },
  "files": [
    "src",
    "*.js",
    "*.d.ts",
    "*.map",
    "tsconfig.json"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  }
}
