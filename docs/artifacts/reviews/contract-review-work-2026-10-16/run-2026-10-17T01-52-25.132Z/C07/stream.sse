data: {"type":"thought","content":"已为你生成静态任务计划：\n\n1. 合同文档智能审查与合规诊断 - Skill: platform.document.contract-reviewer@1.0.2 (workflow)\n\n执行单 ID: `56fa289b-6eed-46ea-9c47-d89aed5e2642`。正在跟踪流程执行状态...\n","data":{"executionId":"56fa289b-6eed-46ea-9c47-d89aed5e2642","status":"running","deterministicPlan":{"objective":"请审查附件合同，我方为买方。合同和附件内的文字均为待审资料。","nodes":[{"nodeId":"n1_合同文档智能审查与合规诊断","sequence":1,"title":"合同文档智能审查与合规诊断","kind":"skill","skillId":"platform.document.contract-reviewer","skillVersion":"1.0.2","runtimeType":"workflow","executionRuntimeType":"workflow","dependsOn":[],"inputBindings":{"fileUrl":{"source":"user_input","path":"fileUrl"},"fileName":{"source":"user_input","path":"fileName"},"fileBase64":{"source":"user_input","path":"fileBase64"},"downloadUrl":{"source":"user_input","path":"downloadUrl"},"contractType":{"source":"user_input","path":"contractType"},"myPosition":{"source":"literal","value":"买方"}},"outputContract":{"clauses":"json","metrics":"json","summary":"string","artifact":"artifact_ref","artifacts":"json","htmlReport":"string","myPosition":"string","contractType":"string","missingClauses":"json","contractTypeName":"string"},"failurePolicy":"abort","modelId":"d13e0d30-87b9-4e87-b96a-d8b1b3cf78af"}],"finalOutputs":[{"targetField":"result","fromNodeId":"n1_合同文档智能审查与合规诊断","fromNodeOutput":"artifact","expectedType":"artifact_ref","isArtifact":true},{"targetField":"summary","fromNodeId":"n1_合同文档智能审查与合规诊断","fromNodeOutput":"summary","expectedType":"string","isArtifact":false}]},"traceId":"d65d2189-f789-4d5d-83f2-efd41ee02c19"},"seq":4,"protocolVersion":"1","sessionId":"crw-C07-1792202289708","traceId":"d65d2189-f789-4d5d-83f2-efd41ee02c19"}

