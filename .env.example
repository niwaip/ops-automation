# Environment Variables Configuration
# Copy this file to .env and fill in the values

# PostgreSQL Configuration
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_secret
POSTGRES_DB=ops
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Application Ports (dynamic allocation)
AUTH_PORT=3001
PORTAL_PORT=3002
TEMPLATE_PORT=3003
AI_ORCHESTRATOR_PORT=3004
BROWSER_WORKER_PORT=3005
SESSION_BROKER_PORT=3006
REPLAY_ENGINE_PORT=3007
CONTROL_PLANE_PORT=3008

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600

# Logging
LOG_LEVEL=info