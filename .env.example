# Environment Variables Configuration
# Copy this file to .env and fill in the values

# PostgreSQL Configuration
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_secret
POSTGRES_DB=ops
POSTGRES_PORT=5432

# Redis Configuration
REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# Service Ports
PLATFORM_PORT=3001
AUTH_PORT=3001
SESSION_BROKER_PORT=3002
CONTROL_PLANE_PORT=3003
BROWSER_WORKER_PORT=3004
BROWSER_TEMPLATE_PORT=3005
REPLAY_ENGINE_PORT=3006
AI_ORCHESTRATOR_PORT=3007
PORTAL_PORT=5173
CARBONE_ENGINE_PORT=3009
OFFICE_ADDIN_PORT=3000
NOVNC_PORT=6080

# Service Discovery & Endpoints
# Use HOST_IP to set the public IP for external access (downloads, VNC, etc.)
HOST_IP=localhost
EXTERNAL_HOST=localhost

# Individual service overrides (optional, defaults to service names in Docker or localhost in dev)
PLATFORM_SERVICE_URL=
AI_ORCHESTRATOR_URL=
SESSION_BROKER_URL=
CONTROL_PLANE_URL=
BROWSER_WORKER_URL=
CARBONE_SERVICE_URL=
CARBONE_EXTERNAL_URL=
TEMPORAL_UI_URL=
WORKFLOW_VALIDATION_AGENT_URL=

# JWT Configuration
JWT_SECRET=your_jwt_secret_here
JWT_EXPIRATION=3600

# Logging
LOG_LEVEL=info

# Local development overrides for docker/scripts/start-dev.sh
DEV_HOST=localhost
DEV_PUBLIC_HOST=
LOCAL_DB_HOST=localhost
LOCAL_REDIS_HOST=localhost

# Frontend runtime overrides
VITE_HOST_IP=
VITE_RECORDER_WS_URL=
VITE_NOVNC_URL=
VITE_OFFICE_ADDIN_BASE_URL=
