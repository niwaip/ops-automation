# Carbone Community Edition Docker
# 使用官方 carbone npm 包，支持 HTTPS

FROM node:18-alpine

# 创建工作目录
WORKDIR /app

# 安装官方 carbone 包 (使用中国镜像源)
RUN npm install carbone express multer jszip --registry=https://registry.npmmirror.com

# 创建简单的 API 服务
COPY carbone-server.js .

# 模板使用命名卷持久化，证书通过只读 volume 挂载
RUN mkdir -p /app/templates /app/certs

# 暴露端口 (HTTP 和 HTTPS)
EXPOSE 3100 3443

# 启动服务
CMD ["node", "carbone-server.js"]
