# Office Add-in Development Docker
# 使用 Vite dev server，支持热更新

FROM node:20-bullseye-slim

WORKDIR /app

# 安装依赖
COPY package.json ./
RUN npm install --registry=https://registry.npmmirror.com

# 复制源码
COPY . .

# 创建证书目录（证书将通过 volume 挂载）
RUN mkdir -p certs

# 暴露端口
EXPOSE 3000

# 启动开发服务器
CMD ["npm", "run", "dev", "--", "--host", "0.0.0.0"]