# ==============================================================================
# Ops Automation - Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env on production hosts.
# Ensure all mandatory secrets are populated with cryptographically random keys.
# DO NOT commit real secrets into version control.
# ==============================================================================

# Node Environment
NODE_ENV=production

# ============================================
# Mandatory Security Secrets (Production Baseline)
# ============================================
# JWT token secret for user authentication
# REQUIREMENT: Must be at least 32 characters, cryptographically random.
# Example generator: openssl rand -base64 32
JWT_SECRET=REPLACE_WITH_OPENSSL_RAND_BASE64_32_CHAR_MINIMUM

# Shared secret for internal machine-to-machine (M2M) service authentication
# REQUIREMENT: Must be at least 16 characters.
# Example generator: openssl rand -hex 24
INTERNAL_API_SHARED_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_24_CHAR_MINIMUM

# Master encryption key for user credentials stored in database (AES-256-GCM)
# REQUIREMENT: Must be at least 16 characters (recommended 32 chars).
# Example generator: openssl rand -hex 32
USER_CREDENTIAL_ENCRYPTION_KEY=REPLACE_WITH_OPENSSL_RAND_HEX_32_CHAR_MINIMUM

# Secret key for HMAC-SHA256 time-bound signatures on browser artifact URLs
# Example generator: openssl rand -hex 24
ARTIFACT_SIGNING_SECRET=REPLACE_WITH_OPENSSL_RAND_HEX_24_CHAR_MINIMUM

# Enforce strict authorization for browser screenshot & video downloads
ARTIFACT_REQUIRE_AUTH=true

# Retention period (in hours) before background cleanup prunes local browser artifacts (default: 48)
ARTIFACT_RETENTION_HOURS=48

# Browser screenshot strategy (smart = capture on navigation/state-change; all = capture every step)
BROWSER_SCREENSHOT_POLICY=smart

# Strict TLS certificate validation for outgoing SMTP / IMAP connections
EMAIL_ALLOW_INSECURE_TLS=false

# ============================================
# Object Storage Governance (Production Fail-Closed)
# ============================================
# Fail-closed policy: reject writes if cloud/remote storage is unreachable (prevents split-brain)
STORAGE_FAIL_CLOSED=true
STORAGE_PROTOCOL=s3
STORAGE_ENDPOINT=https://s3.us-east-1.amazonaws.com
STORAGE_BUCKET=ops-automation-production-artifacts
STORAGE_ACCESS_KEY=YOUR_AWS_OR_MINIO_ACCESS_KEY
STORAGE_SECRET_KEY=YOUR_AWS_OR_MINIO_SECRET_KEY
STORAGE_REGION=us-east-1
STORAGE_USE_SSL=true

# ============================================
# Production Infrastructure
# ============================================
POSTGRES_USER=ops_prod
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_POSTGRES_PASSWORD
POSTGRES_DB=ops_production
POSTGRES_PORT=5432

REDIS_PASSWORD=REPLACE_WITH_STRONG_REDIS_PASSWORD
REDIS_PORT=6379

# ============================================
# Service Ports & Networking
# ============================================
AUTH_PORT=3001
SESSION_BROKER_PORT=3002
CONTROL_PLANE_PORT=3003
BROWSER_WORKER_PORT=3004
TEMPLATE_PORT=3005
REPLAY_ENGINE_PORT=3006
AI_ORCHESTRATOR_PORT=3007
REPORT_PORT=3008
CARBONE_ENGINE_PORT=3009

# Production host IP or domain for external endpoints
HOST_IP=127.0.0.1
DOCKER_REGISTRY=
NETWORK_NAME=ops-network

# ============================================
# AI Model Provider Keys
# ============================================
ALIBABA_CODING_API_KEY=
ALIBABA_BAILIAN_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
TAVILY_API_KEY=
