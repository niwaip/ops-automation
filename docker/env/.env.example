# Ops Automation - Docker Environment Configuration
# Copy this to .env and modify as needed

# ============================================
# Infrastructure
# ============================================
POSTGRES_USER=ops
POSTGRES_PASSWORD=ops_secret
POSTGRES_DB=ops
POSTGRES_PORT=5432

REDIS_PASSWORD=redis_secret
REDIS_PORT=6379

# ============================================
# Service Ports
# ============================================
AUTH_PORT=3001
SESSION_BROKER_PORT=3002
CONTROL_PLANE_PORT=3003
BROWSER_WORKER_PORT=3004
TEMPLATE_PORT=3005
REPLAY_ENGINE_PORT=3006
AI_ORCHESTRATOR_PORT=3007
REPORT_PORT=3008
CARBONE_ENGINE_PORT=3009

# ============================================
# Document Semantic Extraction (Phase 1)
# ============================================
# Enable/disable planner semantic bypass (fallback to field-level required_inputs when false)
DOCUMENT_SEMANTIC_SUBAGENT_ENABLED=true
# Thresholds to classify a doc plan as "complex_document"
DOCUMENT_SEMANTIC_PARAM_THRESHOLD=8
DOCUMENT_SEMANTIC_MISSING_THRESHOLD=4
DOCUMENT_SEMANTIC_ARRAY_GROUP_THRESHOLD=2

# Portal (Vite dev server)
PORTAL_PORT=5173

# Browser Chrome
SESSION_BROWSER_IMAGE=ops-browser-chrome:local
NOVNC_PORT=6080
CDP_PORT=9222
VNC_PORT=5900
CODEGEN_API_PORT=3011

# Office Add-in (HTTPS)
OFFICE_ADDIN_PORT=3000

# Carbone API
CARBONE_API_HTTP_PORT=3100
CARBONE_API_HTTPS_PORT=3443

# ============================================
# Docker Configuration
# ============================================
# Use China mirror for faster image download
# Set to empty string to use official Docker Hub
DOCKER_REGISTRY=docker.1ms.run/library/

# Network name for all services
NETWORK_NAME=ops-network

# ============================================
# LAN Access
# ============================================
# Host IP for LAN access (your machine's IP on the network)
# 设置为 192.168.100.143 可让前端/外部访问链接统一使用本机IP
# 默认 localhost
HOST_IP=192.168.100.143
OFFICE_ADDIN_PUBLIC_HOST=
CARBONE_API_PUBLIC_HOST=
OFFICE_ADDIN_TLS_HOSTS=
DEV_HOST=localhost
DEV_PUBLIC_HOST=
LOCAL_DB_HOST=localhost
LOCAL_REDIS_HOST=localhost

# ============================================
# Service Entry Hosts (optional)
# ============================================
# 默认留空时使用容器服务名（推荐，容器内调用更稳定）
# 如需强制所有入口走本机IP，可设为 192.168.100.143
AUTH_SERVICE_HOST=
AI_ORCHESTRATOR_HOST=
SESSION_BROKER_HOST=
CONTROL_PLANE_HOST=
BROWSER_WORKER_HOST=
CARBONE_ENGINE_HOST=

# ============================================
# Local Dev Script Overrides
# ============================================
# start-dev.sh 会优先读取仓库根目录 .env 中的这些值
PLATFORM_SERVICE_URL=
AUTH_SERVICE_URL=
SESSION_BROKER_URL=
AI_ORCHESTRATOR_URL=
BROWSER_TEMPLATE_SERVICE_URL=
BROWSER_WORKER_URL=
CARBONE_SERVICE_URL=
CARBONE_EXTERNAL_URL=

# Portal runtime overrides
VITE_HOST_IP=
VITE_RECORDER_WS_URL=
VITE_NOVNC_URL=
VITE_OFFICE_ADDIN_BASE_URL=

# ============================================
# AI Model API Keys
# ============================================
ALIBABA_CODING_API_KEY=
ALIBABA_BAILIAN_API_KEY=
OPENAI_API_KEY=
DEEPSEEK_API_KEY=

# ============================================
# Worktree Support (for Vibe Kanban)
# ============================================
# This is automatically set when running in worktree
# Leave empty for normal development
WORKTREE_CONTEXT=
