{
  "id": "c5565469-613a-404e-b249-e43d264bc039",
  "name": "live-export-replay-1781863717",
  "version": "1.0.0",
  "status": "DRAFT",
  "description": "Replay verification from live recorder export",
  "params_schema": {
    "type": "object",
    "required": [
      "startUrl"
    ],
    "properties": {
      "startUrl": {
        "type": "string"
      }
    }
  },
  "steps": [
    {
      "action": "navigate",
      "params": {
        "url": "${startUrl}"
      },
      "step_id": "step_1",
      "description": "打开登录页"
    },
    {
      "action": "wait",
      "params": {
        "seconds": 2
      },
      "step_id": "step_2",
      "description": "短暂等待让网络稳定"
    },
    {
      "action": "click",
      "locator": {
        "type": "role",
        "value": "button[name=\"Reload\"]"
      },
      "step_id": "step_3",
      "description": "点击 Reload 按钮重新加载目标页面"
    },
    {
      "action": "wait",
      "params": {
        "seconds": 2
      },
      "step_id": "step_4",
      "description": "等待页面加载完成"
    },
    {
      "action": "read_value",
      "params": {
        "method": "innerText",
        "selector": "[class*='gross']"
      },
      "locator": {
        "type": "css",
        "value": "[class*='gross']"
      },
      "step_id": "step_5",
      "output_var": "caseGrossMarginRate",
      "description": "读取条件值：判断案件粗利率（毛利率）是否大于20%，大于则自动继续执行后续步骤，否则人工接管"
    },
    {
      "action": "branch",
      "branch": {
        "on_match": "continue",
        "description": "判断案件粗利率（毛利率）是否大于20%，大于则自动继续执行后续步骤，否则人工接管",
        "on_mismatch": "takeover",
        "condition_fn": "(ctx) => { const value = Number(String(ctx.caseGrossMarginRate || '').replace(/[^0-9.-]+/g, '')); return Number.isFinite(value) && value > 20; }",
        "takeover_reason": "案件粗利率（毛利率）未大于20%或页面无法读取该数值，需要人工接管"
      },
      "step_id": "step_6",
      "description": "判断案件粗利率（毛利率）是否大于20%，大于则自动继续执行后续步骤，否则人工接管"
    },
    {
      "action": "snapshot",
      "step_id": "step_7",
      "description": "获取页面快照以定位 '保留中' 元素"
    },
    {
      "action": "click",
      "locator": {
        "type": "role",
        "value": "button[name=\"Reload\"]"
      },
      "step_id": "step_8",
      "description": "点击 Reload 按钮重新加载应用页面"
    }
  ],
