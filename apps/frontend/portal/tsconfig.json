{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@chat-web/*": ["../shared/chat-web/*"],
      "@ops/user-core": ["../../../packages/user-core/src/index.ts"],
      "@ops/backend-ai-chat-protocol": [
        "../../../packages/backend-contracts/ai-chat-protocol/src/index.ts"
      ],
      "@ops/backend-execution-core": [
        "../../../packages/backend-contracts/execution-core/src/index.ts"
      ]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
