{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "types": ["react", "react-dom"],
    "baseUrl": ".",
    "typeRoots": [
      "./node_modules/@types",
      "../../../node_modules/@types",
      "../../../node_modules/.pnpm/node_modules/@types"
    ],
    "paths": {
      "@/*": ["src/*"],
      "@chat-web/*": ["../shared/chat-web/*"],
      "@ops/user-core": ["../../../packages/user-core/src/index.ts"],
      "@ops/backend-ai-chat-protocol": [
        "../../../packages/backend-contracts/ai-chat-protocol/src/index.ts"
      ],
      "@ops/backend-execution-core": [
        "../../../packages/backend-contracts/execution-core/src/index.ts"
      ],
      "react": ["node_modules/@types/react", "node_modules/react"],
      "react-dom": ["node_modules/@types/react-dom", "node_modules/react-dom"],
      "antd": ["node_modules/antd"],
      "@ant-design/icons": ["node_modules/@ant-design/icons"],
      "react-markdown": ["node_modules/react-markdown"],
      "remark-gfm": ["node_modules/remark-gfm"],
      "dayjs": ["../../../node_modules/.pnpm/node_modules/dayjs"]
    }
  },
  "include": ["src"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
