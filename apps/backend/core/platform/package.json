{
  "name": "@ops/platform",
  "version": "1.0.0",
  "private": true,
  "description": "Platform core service (Auth, Execution Flow, etc.)",
  "main": "dist/main.js",
  "types": "dist/main.d.ts",
  "scripts": {
    "build": "prisma generate && pnpm --filter @ops/identity-access run build && pnpm --filter @ops/organization run build && pnpm --filter @ops/release-manager run build && nest build",
    "dev": "prisma generate && nest start --watch",
    "start": "node dist/main.js",
    "start:prod": "node dist/main.js",
    "seed": "ts-node prisma/seed.ts",
    "test": "jest",
    "test:unit": "jest --passWithNoTests",
    "test:integration": "jest --passWithNoTests --config jest.integration.config.js",
    "lint": "eslint src --ext .ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@ops/identity-access": "workspace:*",
    "@ops/organization": "workspace:*",
    "@ops/release-manager": "workspace:*",
    "@ops/backend-release-manifest": "file:../../../../packages/backend-contracts/release-manifest",
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.0",
    "@nestjs/swagger": "^7.4.2",
    "@prisma/client": "^5.22.0",
    "axios": "^1.15.0",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.2.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.3.0",
    "@types/axios": "^0.9.36",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.0",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "jest": "^29.7.0",
    "prisma": "^5.22.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  }
}
