  generatedCodeDigest String   @map("generated_code_digest") @db.VarChar(128)
  fixtureDigest       String?  @map("fixture_digest") @db.VarChar(128)
  validatorVersion    String   @map("validator_version") @db.VarChar(32)
  gateResultsJson     Json     @default("{}") @map("gate_results_json")
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([releaseId, createdAt(sort: Desc)])
  @@map("capability_attestations")
}

model SkillDraft {
  id                        String   @id @default(uuid()) @db.Uuid
  releaseId                 String   @map("release_id") @db.Uuid
  generatedFromBuildId      String?  @map("generated_from_build_id") @db.Uuid
  generatedFromValidationId String?  @map("generated_from_validation_id") @db.Uuid
  sourceType                String   @map("source_type") @db.VarChar(64)
  name                      String   @db.VarChar(255)
  description               String   @db.Text
  triggerKeywords           Json     @default("[]") @map("trigger_keywords")
  paramsSchema              Json     @default("{}") @map("params_schema")
  executionFlowTemplateIds  Json     @default("[]") @map("execution_flow_template_ids")
  tools                     Json     @default("[]")
  apiEndpoints              Json?    @map("api_endpoints")
  draftPayloadJson          Json     @map("draft_payload_json")
  status                    String   @default("draft") @db.VarChar(32)
  createdBy                 String?  @map("created_by") @db.Uuid
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt                 DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz

  @@index([releaseId, updatedAt(sort: Desc)])
  @@map("skill_drafts")
}

model DeploymentRecord {
