{
  "compilerOptions": {
    "module": "commonjs",
    "moduleResolution": "node",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "rootDir": "./src",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strictNullChecks": true,
    "noImplicitAny": true,
    "strictBindCallApply": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "paths": {
      "@/*": ["src/*"],
      "@ops/identity-access": ["../../governance/identity-access/dist"],
      "@ops/organization": ["../../governance/organization/dist"],
      "@ops/workbench": ["../../governance/workbench/dist"],
      "@ops/workbench/*": ["../../governance/workbench/dist/*"],
      "@ops/workflow-registry/*": ["../../registry-release/workflow-registry/dist/*"],
      "@ops/skill-registry/*": ["../../registry-release/skill-registry/dist/*"],
      "@ops/release-manager/*": ["../../registry-release/release-manager/dist/*"],
      "@ops/backend-builtin-skill-contract": ["../../../../packages/backend-contracts/builtin-skill-contract/index.d.ts"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist", "test"]
}
