{
  "name": "@ops/master-planner",
  "version": "1.0.0",
  "private": true,
  "description": "Intelligence master-planner shared exports",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./facade": {
      "types": "./dist/facade/index.d.ts",
      "default": "./dist/facade/index.js"
    },
    "./plan": {
      "types": "./dist/plan/index.d.ts",
      "default": "./dist/plan/index.js"
    },
    "./delegation": {
      "types": "./dist/delegation/index.d.ts",
      "default": "./dist/delegation/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
