{
  "name": "@ops/ai-orchestrator",
  "version": "1.0.0",
  "private": true,
  "description": "AI Orchestrator service for Browser Control Plane - OpenAI compatible API client, model registration, agent instance creation, parameter recognition, and failure decision",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "prisma generate && nest build",
    "dev": "nest start --watch -b swc",
    "start": "node dist/main.js",
    "start:prod": "node dist/main",
    "test": "jest",
    "test:unit": "jest --passWithNoTests",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "lint": "eslint \"{src,test}/**/*.ts\" --fix",
    "typecheck": "tsc --noEmit",
    "prisma:seed": "ts-node -r tsconfig-paths/register src/modules/llm-operation/seed/run-seed.ts",
    "prisma:seed:dev": "ts-node -r tsconfig-paths/register src/modules/llm-operation/seed/run-seed.ts"
  },
  "dependencies": {
    "@ops/backend-agent-profile": "file:../../../../packages/backend-contracts/agent-profile",
    "@ops/backend-browser-execution-contract": "file:../../../../packages/backend-contracts/browser-execution-contract",
    "@ops/backend-deterministic-plan": "file:../../../../packages/backend-contracts/deterministic-plan",
    "@ops/backend-error-codes": "file:../../../../packages/backend-contracts/error-codes",
    "@ops/backend-planning-decision": "file:../../../../packages/backend-contracts/planning-decision",
    "@ops/backend-runtime-capability-contract": "file:../../../../packages/backend-contracts/runtime-capability-contract",
    "@nestjs/common": "^10.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/swagger": "^7.0.0",
    "@prisma/client": "^5.22.0",
    "axios": "^1.14.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "ioredis": "^5.10.1",
    "prisma": "^5.22.0",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.0",
    "uuid": "^9.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/testing": "^10.0.0",
    "@swc/cli": "^0.5.2",
    "@swc/core": "^1.15.21",
    "@types/express": "^4.17.17",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^20.10.0",
    "@types/uuid": "^9.0.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.1.0",
    "typescript": "^5.3.0"
  },
  "jest": {
    "moduleFileExtensions": ["js", "json", "ts"],
    "roots": ["<rootDir>/src", "<rootDir>/test"],
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": ["**/*.(t|j)s"],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
