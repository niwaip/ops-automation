{
  "name": "@ops/workflow-registry",
  "version": "1.0.0",
  "private": true,
  "description": "Registry-release workflow-registry shared exports",
  "exports": {
    "./flow-template": {
      "types": "./dist/flow-template/index.d.ts",
      "default": "./dist/flow-template/index.js"
    },
    "./workflow-template": {
      "types": "./dist/workflow-template/index.d.ts",
      "default": "./dist/workflow-template/index.js"
    },
    "./activity-template": {
      "types": "./dist/activity-template/index.d.ts",
      "default": "./dist/activity-template/index.js"
    },
    "./validation": {
      "types": "./dist/validation/index.d.ts",
      "default": "./dist/validation/index.js"
    },
    "./codegen": {
      "types": "./dist/codegen/index.d.ts",
      "default": "./dist/codegen/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig*.tsbuildinfo && (pnpm exec tsc -p tsconfig.json || tsc -p tsconfig.json)",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@ops/identity-access": "workspace:*",
    "axios": "^1.15.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0",
    "reflect-metadata": "^0.2.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "@types/passport-jwt": "^4.0.1",
    "typescript": "^5.3.0"
  }
}
