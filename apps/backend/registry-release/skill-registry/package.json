{
  "name": "@ops/skill-registry",
  "version": "1.0.0",
  "private": true,
  "description": "Registry-release skill-registry shared exports",
  "exports": {
    "./registry": {
      "types": "./dist/registry/index.d.ts",
      "default": "./dist/registry/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig*.tsbuildinfo && (pnpm exec tsc -p tsconfig.json || tsc -p tsconfig.json)",
