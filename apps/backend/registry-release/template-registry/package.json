{
  "name": "@ops/template-registry",
  "version": "1.0.0",
  "private": true,
  "description": "Registry-release template-registry shared exports",
  "exports": {
    "./browser-template": {
      "types": "./dist/browser-template/index.d.ts",
      "default": "./dist/browser-template/index.js"
    },
    "./document-template": {
      "types": "./dist/document-template/index.d.ts",
      "default": "./dist/document-template/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
