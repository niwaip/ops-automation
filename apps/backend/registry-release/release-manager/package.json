{
  "name": "@ops/release-manager",
  "version": "1.0.0",
  "private": true,
  "description": "Registry-release release-manager shared exports",
  "exports": {
    "./release": {
      "types": "./dist/release/index.d.ts",
      "default": "./dist/release/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist && pnpm --filter @ops/skill-registry run build && (pnpm exec tsc -p tsconfig.json || tsc -p tsconfig.json)",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/swagger": "^7.4.2",
    "@ops/backend-release-manifest": "file:../../../../packages/backend-contracts/release-manifest",
    "@ops/backend-runtime-capability-contract": "file:../../../../packages/backend-contracts/runtime-capability-contract",
    "@ops/identity-access": "workspace:*",
    "@ops/organization": "workspace:*",
    "@ops/skill-registry": "workspace:*",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.0"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
