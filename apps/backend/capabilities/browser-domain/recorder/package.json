{
  "name": "@ops/browser-recorder",
  "version": "1.0.0",
  "private": true,
  "description": "Browser capability domain: recorder logic, durable locator resolution, loop modeling, and export assembly IR",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./constants": {
      "types": "./dist/constants/index.d.ts",
      "default": "./dist/constants/index.js"
    },
    "./locator": {
      "types": "./dist/locator/index.d.ts",
      "default": "./dist/locator/index.js"
    },
    "./execution-plan": {
      "types": "./dist/execution-plan/index.d.ts",
      "default": "./dist/execution-plan/index.js"
    },
    "./loop": {
      "types": "./dist/loop/index.d.ts",
      "default": "./dist/loop/index.js"
    }
  },
  "scripts": {
    "build": "rm -rf dist tsconfig*.tsbuildinfo && (pnpm exec tsc -p tsconfig.json || tsc -p tsconfig.json)",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@nestjs/common": "^10.3.0",
    "@nestjs/core": "^10.3.0",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/node": "^20.10.0",
    "typescript": "^5.3.0"
  }
}
